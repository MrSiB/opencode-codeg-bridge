{
  "name": "opencode-codeg-bridge",
  "version": "0.1.0",
  "description": "Standalone zero-native-dependency OpenCode plugin and CLI bridging OmO plans to Codeg",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "omo-codeg": "./dist/bin/omo-codeg.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "import": "./dist/src/errors.js"
    },
    "./backup": {
      "types": "./dist/src/backup.d.ts",
      "import": "./dist/src/backup.js"
    },
    "./sync": {
      "types": "./dist/src/sync.d.ts",
      "import": "./dist/src/sync.js"
    },
    "./sqlite": {
      "types": "./dist/src/sqlite.d.ts",
      "import": "./dist/src/sqlite.js"
    },
    "./cli": {
      "types": "./dist/src/cli.d.ts",
      "import": "./dist/src/cli.js"
    },
    "./parser": {
      "types": "./dist/src/parser.d.ts",
      "import": "./dist/src/parser.js"
    },
    "./discovery": {
      "types": "./dist/src/discovery.d.ts",
      "import": "./dist/src/discovery.js"
    }
  },
  "files": [
    "dist",
    "bin/omo-codeg",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.16",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
